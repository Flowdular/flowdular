# Copy to infra/docker/.env. Never commit the copy.
# Generate each key with: openssl rand -base64 32
FD_AGENT_CREDENTIAL_KEY=
FD_AGENT_RUN_GRANT_KEY=
FD_WORKFLOWS_PAYLOAD_KEY=
FD_WORKFLOWS_CURSOR_KEY=

# PostgreSQL credentials. The superuser only bootstraps the cluster; the app
# connects as coreloom_runtime and migrates as coreloom_migrator.
FD_POSTGRES_SUPERUSER_PASSWORD=
FD_DATABASE_MIGRATOR_PASSWORD=
FD_DATABASE_RUNTIME_PASSWORD=
FD_DATABASE_BACKGROUND_PASSWORD=

# Host port for the published container port 3000.
FD_PORT=3000

# Keep true behind TLS. Set to false only for a plain-HTTP run on a
# workstation; the session cookie then loses the Secure flag and __Host- prefix.
FD_AUTH_SECURE_COOKIE=true

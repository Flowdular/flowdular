# node infra/docker/start.mjs creates infra/docker/.env automatically.
# To use docker compose directly, copy this file and fill every required secret.
# Never commit the copy. Generate encryption keys with: openssl rand -base64 32
# Set a different project name for each app so their named volumes cannot mix.
COMPOSE_PROJECT_NAME=
FD_AGENT_CREDENTIAL_KEY=
FD_AGENT_CREDENTIAL_KEY_PREVIOUS=
FD_AGENT_RUN_GRANT_KEY=
FD_AUTH_MFA_KEY=
FD_AUTH_MFA_KEY_PREVIOUS=
FD_APPROVAL_GRANT_KEY=
FD_APPROVAL_GRANT_KEY_PREVIOUS=
FD_AUTOMATIONS_CREDENTIAL_KEY=
FD_AUTOMATIONS_CREDENTIAL_KEY_PREVIOUS=
FD_NOTIFICATIONS_SECRET_KEY=
FD_NOTIFICATIONS_SECRET_KEY_PREVIOUS=
FD_WORKFLOWS_PAYLOAD_KEY=
FD_WORKFLOWS_PAYLOAD_KEY_PREVIOUS=
FD_WORKFLOWS_CURSOR_KEY=
FD_WORKFLOWS_CURSOR_KEY_PREVIOUS=
FD_STORAGE_ENCRYPTION_KEY=
FD_STORAGE_ENCRYPTION_KEY_PREVIOUS=
FD_CONNECTORS_SECRET_KEY=
FD_CONNECTORS_SECRET_KEY_PREVIOUS=
FD_AUDIT_ANCHOR_KEY=
FD_AUDIT_ANCHOR_KEY_PREVIOUS=

# The default S3-compatible store is the MinIO service in compose.yaml, with a
# private flowdular bucket. Override these values for an external S3 service.
# Back up the MinIO object volume with PostgreSQL and this .env file.
FD_MINIO_ROOT_PASSWORD=
FD_STORAGE_S3_BUCKET=
FD_STORAGE_S3_REGION=
FD_STORAGE_S3_ENDPOINT=
FD_STORAGE_S3_ACCESS_KEY_ID=
FD_STORAGE_S3_SECRET_ACCESS_KEY=
FD_STORAGE_S3_FORCE_PATH_STYLE=true

# PostgreSQL credentials. The superuser only bootstraps the cluster; the app
# connects as flowdular_runtime and migrates as flowdular_migrator. Newly created
# passwords are URL-safe hex. Existing passwords are kept as-is.
FD_POSTGRES_SUPERUSER_PASSWORD=
FD_DATABASE_MIGRATOR_PASSWORD=
FD_DATABASE_RUNTIME_PASSWORD=
FD_DATABASE_BACKGROUND_PASSWORD=

# Outgoing mail. With none, workspace invitations are refused and password reset
# messages are never delivered. Set smtp and both values below to send them; the
# URL carries the relay password, so treat this file as a secret.
FD_AUTH_MAIL_TRANSPORT=none
FD_AUTH_SMTP_URL=
FD_AUTH_MAIL_FROM=

# Host port for the published container port 3000.
FD_PORT=3000
FD_BIND_ADDRESS=127.0.0.1
FD_APPLICATION_PATH=/app
FD_AUTH_PUBLIC_ORIGIN=

# The local launcher writes false for HTTP on a workstation. For a deployment
# behind TLS, set true and set FD_AUTH_PUBLIC_ORIGIN to its HTTPS origin.
FD_AUTH_SECURE_COOKIE=

# Tenant id that overrides the operator workspace, the one that changes platform
# settings such as the branding and the mail relay. Empty, the workspace auth.core
# recorded at first-run setup decides (pnpm flowdular auth operator shows it).
FD_OPERATOR_TENANT=

# Prometheus exposition on GET /api/metrics. Leave FD_METRICS unset to keep it off.
FD_METRICS=false
FD_METRICS_TOKEN=

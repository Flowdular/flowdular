# Copy to infra/docker/.env. Never commit the copy.
# Generate each key with: openssl rand -base64 32
OERP_AGENT_CREDENTIAL_KEY=
OERP_AGENT_RUN_GRANT_KEY=

# Host port for the published container port 3000.
OERP_PORT=3000

# Keep true behind TLS. Set to false only for a plain-HTTP run on a
# workstation; the session cookie then loses the Secure flag and __Host- prefix.
OERP_AUTH_SECURE_COOKIE=true

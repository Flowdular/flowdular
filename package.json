{
	"name": "flowdular",
	"version": "0.6.5",
	"private": true,
	"type": "module",
	"description": "Flowdular is an agentic foundation framework for OctaneJS: a production platform core that teams extend with modules built by AI agents.",
	"packageManager": "pnpm@11.17.0",
	"engines": {
		"node": ">=22.22.2"
	},
	"scripts": {
		"dev": "node platform/scripts/dev.mjs",
		"build": "pnpm --filter @flowdular/cli build && pnpm --filter @flowdular/cli smoke && node packages/cli/dist/index.js module sync --apply && pnpm --filter @flowdular/platform build",
		"preview": "pnpm --filter @flowdular/platform preview",
		"sandbox": "node packages/sandbox/bin/flowdular-sandbox.mjs",
		"typecheck": "pnpm -r --if-present typecheck",
		"test": "pnpm test:docker-launcher && pnpm -r --workspace-concurrency=2 --if-present test",
		"test:docker-launcher": "node --test infra/docker/start.test.mjs infra/docker/database-urls.test.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"flowdular": "pnpm --filter @flowdular/cli dev",
		"fd": "pnpm flowdular",
		"doctor": "pnpm flowdular doctor",
		"rules:generate": "rulesync generate",
		"rules:check": "rulesync generate --check",
		"validate": "pnpm flowdular spec validate --all && pnpm flowdular blueprint validate --all && pnpm flowdular module validate",
		"verify": "pnpm verify:static && pnpm test",
		"verify:static": "pnpm rules:check && pnpm legacy-name:check && pnpm capabilities:check && pnpm module-conformance && pnpm rule-citations && pnpm platform-api:check && pnpm dom-properties:check && pnpm ui-classes:check && pnpm release-versions:check && pnpm typecheck && pnpm validate && pnpm format:check",
		"release:pack": "node scripts/package-sdk.mjs",
		"release:smoke": "node scripts/smoke-sdk.mjs",
		"legacy-name:check": "node scripts/legacy-name.mjs --check",
		"capabilities:check": "node scripts/platform-capabilities.mjs --check",
		"module-conformance": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/module-conformance.mjs",
		"platform-api:check": "node scripts/platform-api.mjs --check",
		"dom-properties:check": "node scripts/dom-properties.mjs --check",
		"ui-classes:check": "node scripts/ui-classes.mjs --check",
		"release-versions:check": "node scripts/release-versions.mjs --check",
		"ui:preview": "node scripts/ui-preview.mjs",
		"docs:render": "node scripts/render-doc.mjs --all",
		"eval": "node scripts/eval.mjs",
		"eval:approve": "node scripts/eval.mjs --approve",
		"platform-api:update": "node scripts/platform-api.mjs --update",
		"release:publish": "node scripts/publish-sdk.mjs",
		"rule-citations": "node scripts/rule-citations.mjs"
	},
	"devDependencies": {
		"@tsrx/prettier-plugin": "0.3.120",
		"prettier": "3.6.2",
		"rulesync": "16.21.0"
	},
	"homepage": "https://flowdular.com"
}

{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"blueprint",
		"moduleId",
		"change",
		"touchList",
		"specVersionBump",
		"gates"
	],
	"properties": {
		"blueprint": {
			"const": "edit-module@1.0.0"
		},
		"moduleId": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
		},
		"change": {
			"type": "string",
			"enum": [
				"endpoint",
				"table",
				"column",
				"screen",
				"widget",
				"permission",
				"setting",
				"cross-module-read",
				"fix"
			]
		},
		"touchList": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string",
				"pattern": "^modules/[a-z0-9-]+/"
			},
			"uniqueItems": true
		},
		"specVersionBump": {
			"type": "string",
			"enum": ["patch", "minor"]
		},
		"gates": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string",
				"enum": [
					"spec-schema",
					"module-schema",
					"dependencies",
					"typecheck",
					"tests",
					"format"
				]
			},
			"uniqueItems": true
		}
	}
}

{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"blueprint",
		"rootCause",
		"owningLayer",
		"regressionTest",
		"siblings",
		"gates"
	],
	"properties": {
		"blueprint": {
			"const": "bug-fix@1.0.0"
		},
		"rootCause": {
			"type": "string",
			"minLength": 8
		},
		"owningLayer": {
			"type": "string",
			"enum": ["http", "service", "repository", "client", "composition", "core"]
		},
		"regressionTest": {
			"type": "string",
			"minLength": 1
		},
		"siblings": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"uniqueItems": true
		},
		"gates": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string",
				"enum": [
					"spec-schema",
					"module-schema",
					"dependencies",
					"typecheck",
					"tests",
					"format"
				]
			},
			"uniqueItems": true
		}
	}
}

{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": ["kind", "target"],
	"properties": {
		"kind": {
			"type": "string",
			"enum": ["module", "package", "pull-request"]
		},
		"target": {
			"type": "string",
			"minLength": 1
		},
		"diffRef": {
			"type": "string",
			"minLength": 1
		}
	}
}

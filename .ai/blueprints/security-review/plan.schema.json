{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": ["blueprint", "checksRun", "findings", "verdict"],
	"properties": {
		"blueprint": {
			"const": "security-review@1.0.0"
		},
		"checksRun": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string",
				"minLength": 1
			},
			"uniqueItems": true
		},
		"findings": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"severity",
					"claim",
					"location",
					"scenario",
					"rule",
					"fix"
				],
				"properties": {
					"severity": {
						"type": "string",
						"enum": ["blocker", "should-fix", "taste"]
					},
					"claim": {
						"type": "string",
						"minLength": 1
					},
					"location": {
						"type": "string",
						"minLength": 1
					},
					"scenario": {
						"type": "string",
						"minLength": 1
					},
					"rule": {
						"type": "string",
						"minLength": 1
					},
					"fix": {
						"type": "string",
						"minLength": 1
					}
				}
			}
		},
		"verdict": {
			"type": "string",
			"enum": ["approved", "changes-required"]
		}
	}
}

{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"blueprint",
		"moduleId",
		"specDigest",
		"allowedPaths",
		"steps",
		"gates"
	],
	"properties": {
		"blueprint": {
			"const": "new-module@1.0.0"
		},
		"moduleId": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
		},
		"specDigest": {
			"type": "string",
			"pattern": "^sha256:[a-f0-9]{64}$"
		},
		"allowedPaths": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string",
				"pattern": "^modules/[a-z0-9-]+/"
			},
			"uniqueItems": true
		},
		"steps": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string"
			}
		},
		"gates": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string",
				"enum": [
					"spec-schema",
					"module-schema",
					"dependencies",
					"typecheck",
					"tests",
					"format"
				]
			},
			"uniqueItems": true
		}
	}
}

{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": ["blueprint", "moduleId", "specDigest", "steps", "gates"],
	"properties": {
		"blueprint": { "const": "agentic-module@1.0.0" },
		"moduleId": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
		},
		"specDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
		"steps": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "string" }
		},
		"gates": {
			"type": "array",
			"minItems": 1,
			"items": {
				"enum": [
					"spec-schema",
					"module-schema",
					"dependencies",
					"typecheck",
					"tests",
					"format",
					"auto-review"
				]
			},
			"uniqueItems": true
		}
	}
}

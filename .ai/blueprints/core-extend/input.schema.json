{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": ["package", "change", "brief"],
	"properties": {
		"package": {
			"type": "string",
			"enum": [
				"@coreloom/contracts",
				"@coreloom/kernel",
				"@coreloom/server",
				"@coreloom/client",
				"@coreloom/ui",
				"@coreloom/cli",
				"@coreloom/cli-protocol",
				"@coreloom/sandbox",
				"@coreloom/coding-agent",
				"@coreloom/harness",
				"@coreloom/ai-provider",
				"@coreloom/dev-console",
				"@coreloom/platform",
				"@coreloom/module-auth"
			]
		},
		"change": {
			"type": "string",
			"enum": [
				"schema",
				"server-contract",
				"client-contract",
				"ui-primitive",
				"cli",
				"sandbox",
				"coding-agent",
				"kernel",
				"composition"
			]
		},
		"brief": {
			"type": "string",
			"minLength": 8,
			"maxLength": 20000
		},
		"consumers": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"uniqueItems": true
		}
	}
}

{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": ["package", "change", "brief"],
	"properties": {
		"package": {
			"type": "string",
			"enum": [
				"@flowdular/contracts",
				"@flowdular/kernel",
				"@flowdular/server",
				"@flowdular/client",
				"@flowdular/ui",
				"@flowdular/cli",
				"@flowdular/cli-protocol",
				"@flowdular/sandbox",
				"@flowdular/coding-agent",
				"@flowdular/harness",
				"@flowdular/ai-provider",
				"@flowdular/dev-console",
				"@flowdular/platform",
				"@flowdular/module-auth"
			]
		},
		"change": {
			"type": "string",
			"enum": [
				"schema",
				"server-contract",
				"client-contract",
				"ui-primitive",
				"cli",
				"sandbox",
				"coding-agent",
				"kernel",
				"composition"
			]
		},
		"brief": {
			"type": "string",
			"minLength": 8,
			"maxLength": 20000
		},
		"consumers": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"uniqueItems": true
		}
	}
}

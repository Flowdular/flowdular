.git
.github
.DS_Store
# Matched against the whole context-relative path, so a root-anchored .env*
# would still copy infra/docker/.env into the builder image.
**/.env
**/.env.*
!**/.env.example
**/node_modules
**/dist
**/coverage
# Never send preserved pre-Flowdular databases or keys to the build context.
**/.octane-erp
.octane-erp/
**/.flowdular
.flowdular/
*.log

.coreloom/

{
	"$schema": "../../packages/contracts/schemas/module.schema.json",
	"schemaVersion": 1,
	"id": "workflows.core",
	"package": "@flowdular/module-workflows",
	"version": "0.6.6",
	"profile": "full",
	"capabilities": [
		"api",
		"database",
		"client",
		"translations",
		"integration",
		"cli"
	],
	"platform": {
		"server": true,
		"client": true
	},
	"dependencies": [

{
	"name": "@flowdular/module-connectors",
	"version": "0.1.4",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client/index.ts",
		"./server": "./src/server/index.ts",
		"./platform": "./src/platform.ts",
		"./module.json": "./module.json"
	},
	"files": [
		"src",
		"schemas",
		"dist",
		"bin",
		"public",

		"@flowdular/ui": "workspace:*",
		"@types/sax": "1.2.7",
		"docx": "9.5.1",
		"octane": "0.1.51",
		"pdfmake": "0.3.11",
		"sax": "1.6.1",
		"segment-state": "0.2.1",

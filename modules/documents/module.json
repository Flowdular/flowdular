{
	"$schema": "../../packages/contracts/schemas/module.schema.json",
	"schemaVersion": 1,
	"id": "documents.core",
	"package": "@flowdular/module-documents",
	"version": "0.3.4",
	"platformApi": "^0.1.0",
	"profile": "full",
	"capabilities": ["api", "database", "client", "translations", "cli"],
	"platform": {
		"server": true,
		"client": true
	},
	"dependencies": [
		{
			"id": "system.core",
			"range": "^0.9.0"
		},
		{
			"id": "auth.core",
			"range": "^0.14.0"
		}
	],
	"provides": [
		"documents.attachments.v1",
		"documents.text.v1",
		"documents.templates.v1"
	],
	"requires": [
		{
			"id": "connectors.egress.v1",
			"optional": true
		}
	],
	"tenancy": "required",
	"locales": ["en", "pl"],
	"stability": "experimental",
	"cli": {
		"catalog": "src/cli/commands.json",
		"entry": "src/cli/index.ts"
	}
}

{
	"name": "@coreloom/cli",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"oerp": "./dist/index.js"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"dev": "tsx src/index.ts",
		"build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:ajv/* --external:yaml --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\"",
		"smoke": "node dist/index.js doctor --json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@coreloom/cli-protocol": "workspace:*",
		"@coreloom/contracts": "workspace:*",
		"@coreloom/kernel": "workspace:*",
		"ajv": "8.20.0",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@types/node": "24.13.3",
		"esbuild": "0.27.4",
		"tsx": "4.21.0",
		"typescript": "5.9.3",
		"vitest": "4.1.10"
	}
}

exports[`module scaffolding > produces unchanged output for a version 1 specification > src/services/database-repository.ts 1`] = `
"import type { DatabaseHandle } from '@flowdular/database';
import { integer, runDatabaseMigrations } from '@flowdular/database';
import type { InventoryRecord } from '../domain/types.ts';
import { databaseMigrations } from './migration.ts';
import type { InventoryRepository } from './repository.ts';

interface InventoryRecordRow {
	id: string;
	tenant_id: string;
	name: string;
	status: InventoryRecord['status'];
	created_at: number | bigint | string;
}

/* Queries stay explicit. Values always travel in the adapter's parameter
   channel; nothing from a request is concatenated into SQL. */
const LIST = \`SELECT id, tenant_id, name, status, created_at
			 FROM inventory_records
			 WHERE tenant_id = $1
			 ORDER BY lower(name), id\`;

const CREATE = \`INSERT INTO inventory_records
			 (id, tenant_id, name, status, created_at)
			 VALUES ($1, $2, $3, $4, $5)\`;

function fromRow(row: InventoryRecordRow): InventoryRecord {
	return {
		id: row.id,
		tenantId: row.tenant_id,
		name: row.name,
		status: row.status,
		createdAt: integer(row.created_at, 'created_at', { min: 0 }),
	};
}

/** A repository over a platform-owned PostgreSQL handle. */
export class DatabaseInventoryRepository implements InventoryRepository {
	constructor(private readonly database: DatabaseHandle) {}

	async list(tenantId: string): Promise<readonly InventoryRecord[]> {
		const result = await this.database.transaction(
			(transaction) =>
				transaction.query<InventoryRecordRow>({
					text: LIST,
					parameters: [tenantId],
				}),
			{ access: 'read', tenantId },
		);
		return result.rows.map(fromRow);
	}

	async create(record: InventoryRecord): Promise<InventoryRecord> {
		await this.database.transaction(
			(transaction) =>
				transaction.execute({
					text: CREATE,
					parameters: [
						record.id,
						record.tenantId,
						record.name,
						record.status,
						record.createdAt,
					],
				}),
			{ access: 'write', tenantId: record.tenantId },
		);
		return record;
	}
}

export async function migrateInventoryDatabase(
	database: DatabaseHandle,
): Promise<void> {
	await runDatabaseMigrations(database, 'inventory.core', databaseMigrations);
}
"
`;

exports[`module scaffolding > produces unchanged output for a version 1 specification > src/services/inventory-service.ts 1`] = `
"import { randomUUID } from 'node:crypto';
import type {
	CreateInventoryRecordInput,
	InventoryRecord,
} from '../domain/types.ts';
import type { InventoryRepository } from './repository.ts';

export class InventoryServiceError extends Error {
	constructor(
		readonly code: string,
		message: string,
		readonly status = 400,
	) {
		super(message);
		this.name = 'InventoryServiceError';
	}
}

function bounded(
	value: string,
	field: string,
	min: number,
	max: number,
): string {
	const normalized = value.trim();
	if (normalized.length < min || normalized.length > max) {
		throw new InventoryServiceError(
			'INVALID_INPUT',
			\`\${field} must contain between \${min} and \${max} characters.\`,
		);
	}
	return normalized;
}

export class InventoryService {
	constructor(private readonly repository: InventoryRepository) {}

	list(tenantId: string): Promise<readonly InventoryRecord[]> {
		return this.repository.list(bounded(tenantId, 'tenantId', 1, 128));
	}

	create(
		tenantId: string,
		input: CreateInventoryRecordInput,
	): Promise<InventoryRecord> {
		return this.repository.create({
			id: randomUUID(),
			tenantId: bounded(tenantId, 'tenantId', 1, 128),
			name: bounded(input.name, 'name', 2, 160),
			status: 'active',
			createdAt: Date.now(),
		});
	}
}
"
`;


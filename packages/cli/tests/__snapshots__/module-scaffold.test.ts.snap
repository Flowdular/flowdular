"CREATE TABLE IF NOT EXISTS inventory_records (
  id TEXT PRIMARY KEY,
  tenant_id TEXT NOT NULL,
  name TEXT NOT NULL,
  status TEXT NOT NULL CHECK (status IN ('active', 'archived')),
  created_at BIGINT NOT NULL
);
CREATE INDEX IF NOT EXISTS inventory_records_tenant_name_idx
  ON inventory_records (tenant_id, name, id);
ALTER TABLE inventory_records ENABLE ROW LEVEL SECURITY;
ALTER TABLE inventory_records FORCE ROW LEVEL SECURITY;
CREATE POLICY inventory_records_tenant_policy ON inventory_records
  USING (tenant_id = current_setting('coreloom.tenant_id', true))
  WITH CHECK (tenant_id = current_setting('coreloom.tenant_id', true));
"
`;

exports[`module scaffolding > produces unchanged output for a version 1 specification > src/api/endpoints.ts 1`] = `
"import {
	defineEndpoint,
	jsonResponse,
	problemResponse,
	readJsonObject,
	requiredString,
} from '@flowdular/server';
import type { AuthRuntime } from '@flowdular/module-auth/server';
import {
	endpointIdentityFromContext,
	principalFromContext,
	sessionMutationDenial,
} from '@flowdular/module-auth/server';
import { INVENTORY_PERMISSIONS } from '../acl/permissions.ts';
import type { InventoryRuntime } from '../server/runtime.ts';
import { InventoryServiceError } from '../services/inventory-service.ts';

function failure(error: unknown): Response {
	if (error instanceof InventoryServiceError) {
		return jsonResponse(
			{ error: { code: error.code, message: error.message } },
			error.status,
		);
	}
	return problemResponse(error, 'The inventory operation failed.');
}

export function createInventoryRoutes(
	auth: AuthRuntime,
	runtime: InventoryRuntime,
) {
	const list = defineEndpoint({
		id: 'inventory.records.list',
		path: '/api/inventory/records',
		methods: ['GET'],
		access: { kind: 'permission', permission: INVENTORY_PERMISSIONS.read },
		resolveIdentity: endpointIdentityFromContext,
		handler: async ({ octane }) => {
			const service = await runtime.service();
			return jsonResponse({
				records: await service.list(principalFromContext(octane)!.tenantId),
			});
		},
	});
	const create = defineEndpoint({
		id: 'inventory.records.create',
		path: '/api/inventory/records',
		methods: ['POST'],
		access: { kind: 'permission', permission: INVENTORY_PERMISSIONS.manage },
		resolveIdentity: endpointIdentityFromContext,
		handler: async ({ octane }) => {
			const denial = sessionMutationDenial(octane, auth);
			if (denial) return denial;
			try {
				const value = await readJsonObject(octane.request);
				const service = await runtime.service();
				const record = await service.create(
					principalFromContext(octane)!.tenantId,
					{ name: requiredString(value, 'name', { min: 2, max: 160 }) },
				);
				return jsonResponse({ record }, 201);
			} catch (error) {
				return failure(error);
			}
		},
	});
	return [list.serverRoute, create.serverRoute] as const;
}

export const endpoints = [
	'inventory.records.list',
	'inventory.records.create',
] as const;
"
`;

exports[`module scaffolding > produces unchanged output for a version 1 specification > src/client/InventoryView.tsrx 1`] = `
"import { useEffect, useMemo } from 'octane';
import { t } from '@flowdular/client';
import {
	Alert,
	Button,
	Icon,
	PageHeader,
	TableCard,
	type TableColumn,
} from '@flowdular/ui';
import { useValue } from 'segment-state';
import type { InventoryRecord } from '../domain/types.ts';
import { loadInventoryRecords } from './api.ts';
import { createInventoryClientState } from './state.ts';

export interface InventoryViewProps {
	readonly csrfToken: string;
}

function columns(): readonly TableColumn<InventoryRecord>[] {
	return [
		{
			key: 'name',
			header: t('inventory.table.column.name'),
			width: '65%',
			cell: (record) => <b>{record.name}</b>,
		},
		{
			key: 'status',
			header: t('inventory.table.column.status'),
			width: '35%',
			cell: (record) => t('inventory.status.' + record.status),
		},
	];
}

export function InventoryView(_props: InventoryViewProps) @{
	const viewState = useMemo(() => createInventoryClientState(), []);
	const [records] = useValue(viewState.state.records);
	const [status, setStatus] = useValue(viewState.state.status);
	const [error, setError] = useValue(viewState.state.error);

	const refresh = async () => {
		setStatus('loading');
		setError('');
		try {
			const loaded = await loadInventoryRecords();
			viewState.store.act(
				(transaction) => transaction.set(viewState.state.records, loaded),
				'inventory/loaded',
			);
		} catch (loadError) {
			setError(
				loadError instanceof Error
					? loadError.message
					: t('inventory.error.load'),
			);
		} finally {
			setStatus('idle');
		}
	};

	useEffect(() => {
		void refresh();
	}, []);

	<div class="ui-view">
		<PageHeader
			eyebrow={t('inventory.page.eyebrow')}
			title={t('inventory.page.title')}
			description={t('inventory.page.description')}
		>
			<Button size="sm" onClick={() => void refresh()}>
				<Icon name="refresh" size={14} />
				{t('inventory.action.refresh')}
			</Button>
		</PageHeader>
		@if (error) {
			<Alert>{error}</Alert>
		}
		<TableCard
			title={t('inventory.table.title')}
			count={t('inventory.table.count', {
				count: records.length,
			})}
			caption={t('inventory.table.caption')}
			columns={columns()}
			rows={records}
			rowKey={(record) => record.id}
			status={status === 'loading' && records.length === 0 ? 'loading' : 'idle'}
			loadingLabel={t('inventory.table.loading')}
			empty={{
				icon: 'modules',
				title: t('inventory.table.emptyTitle'),
				hint: t('inventory.table.emptyHint'),
			}}
		/>
	</div>
}
"
`;


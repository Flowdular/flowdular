{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://octane-erp.dev/schemas/blueprint.schema.json",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"id",
		"version",
		"architecture",
		"risk",
		"owner",
		"agentRoles",
		"executorProfiles",
		"requiredReviewers",
		"requiresApprovedSpec",
		"status"
	],
	"properties": {
		"$schema": { "type": "string" },
		"schemaVersion": { "const": 1 },
		"id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
		"version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
		"architecture": { "type": "string", "minLength": 1 },
		"risk": {
			"enum": ["read", "workspace-write", "process", "external", "destructive"]
		},
		"owner": { "type": "string", "minLength": 1 },
		"agentRoles": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "string" },
			"uniqueItems": true
		},
		"executorProfiles": {
			"type": "array",
			"items": { "type": "string" },
			"uniqueItems": true
		},
		"requiredReviewers": {
			"type": "array",
			"items": { "type": "string" },
			"uniqueItems": true
		},
		"requiresApprovedSpec": { "type": "boolean" },
		"status": { "enum": ["draft", "approved", "deprecated"] }
	}
}

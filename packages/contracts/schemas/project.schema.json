{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://octane-erp.dev/schemas/project.schema.json",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"architectureVersion",
		"specs",
		"modules",
		"locales",
		"agent"
	],
	"properties": {
		"$schema": { "type": "string" },
		"schemaVersion": { "const": 1 },
		"architectureVersion": {
			"type": "string",
			"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
		},
		"specs": {
			"type": "object",
			"additionalProperties": false,
			"required": ["platformRoot", "moduleDirectory"],
			"properties": {
				"platformRoot": { "type": "string", "minLength": 1 },
				"moduleDirectory": { "type": "string", "minLength": 1 }
			}
		},
		"modules": {
			"type": "object",
			"additionalProperties": false,
			"required": ["roots", "enabled"],
			"properties": {
				"roots": {
					"type": "array",
					"minItems": 1,
					"items": { "type": "string", "minLength": 1 },
					"uniqueItems": true
				},
				"enabled": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
					},
					"uniqueItems": true
				}
			}
		},
		"locales": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
			"uniqueItems": true
		},
		"agent": {
			"type": "object",
			"additionalProperties": false,
			"required": ["policy", "blueprints", "modelRouting"],
			"properties": {
				"policy": { "type": "string", "minLength": 1 },
				"blueprints": { "type": "string", "minLength": 1 },
				"modelRouting": { "type": "string", "minLength": 1 }
			}
		},
		"sandbox": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"delivery": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"default": { "$ref": "#/$defs/deliveryTarget" },
						"targets": {
							"type": "array",
							"minItems": 1,
							"items": { "$ref": "#/$defs/deliveryTarget" },
							"uniqueItems": true
						},
						"git": {
							"type": "object",
							"additionalProperties": false,
							"properties": {
								"remote": { "$ref": "#/$defs/gitName" },
								"baseBranch": { "$ref": "#/$defs/gitName" },
								"branchPrefix": { "$ref": "#/$defs/gitName" },
								"provider": { "enum": ["github", "none"] },
								"reviewers": {
									"type": "array",
									"items": { "type": "string", "minLength": 1 },
									"uniqueItems": true
								}
							}
						},
						"maxChangedFiles": { "type": "integer", "minimum": 1 }
					}
				}
			}
		}
	},
	"$defs": {
		"deliveryTarget": { "enum": ["workspace", "git-pr"] },
		"gitName": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
		}
	}
}

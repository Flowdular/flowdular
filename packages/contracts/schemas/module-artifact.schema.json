{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://flowdular.dev/schemas/module-artifact.schema.json",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "manifest", "review", "files"],
	"properties": {
		"schemaVersion": {
			"const": 1
		},
		"manifest": {
			"$ref": "https://flowdular.dev/schemas/module.schema.json"
		},
		"review": {
			"type": "object",
			"additionalProperties": false,
			"required": ["sourceSha256", "requirements", "findings", "checks"],
			"properties": {
				"sourceSha256": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				},
				"requirements": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"findings": {
					"type": "array",
					"maxItems": 0
				},
				"checks": {
					"type": "array",
					"minItems": 3,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["name", "command", "exitCode"],
						"properties": {
							"name": {
								"enum": ["typecheck", "test", "validate"]
							},
							"command": {
								"type": "string",
								"minLength": 1
							},
							"exitCode": {
								"const": 0
							}
						}
					}
				}
			}
		},
		"files": {
			"type": "array",
			"maxItems": 4096,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["path", "content", "sha256"],
				"properties": {
					"path": {
						"type": "string",
						"minLength": 1,
						"maxLength": 239
					},
					"content": {
						"type": "string"
					},
					"sha256": {
						"type": "string",
						"pattern": "^[a-f0-9]{64}$"
					}
				}
			}
		}
	}
}

{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://flowdular.dev/schemas/module-spec.schema.json",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"id",
		"specVersion",
		"status",
		"name",
		"description",
		"profile",
		"capabilities",
		"dependencies",
		"tenancy",
		"locales"
	],
	"properties": {
		"$schema": { "type": "string" },
		"schemaVersion": { "const": 1 },
		"id": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
		},
		"specVersion": {
			"type": "string",
			"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
		},
		"status": {
			"enum": ["draft", "in-review", "approved", "implemented", "deprecated"]
		},
		"name": { "type": "string", "minLength": 1 },
		"description": { "type": "string", "minLength": 1 },
		"profile": { "enum": ["full", "headless", "ui", "integration"] },
		"capabilities": {
			"type": "array",
			"items": {
				"enum": [
					"api",
					"database",
					"client",
					"translations",
					"integration",
					"cli"
				]
			},
			"uniqueItems": true
		},
		"dependencies": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "range"],
				"properties": {
					"id": { "type": "string" },
					"range": { "type": "string" }
				}
			}
		},
		"tenancy": { "enum": ["required", "optional", "none"] },
		"locales": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "string" },
			"uniqueItems": true
		},
		"invariants": {
			"type": "array",
			"items": { "type": "string", "minLength": 1 },
			"uniqueItems": true
		},
		"permissions": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "description"],
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
					},
					"description": { "type": "string", "minLength": 1 }
				}
			},
			"uniqueItems": true
		},
		"dataOwnership": {
			"type": "array",
			"items": { "type": "string", "minLength": 1 },
			"uniqueItems": true
		},
		"acceptanceScenarios": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "given", "when", "then"],
				"properties": {
					"id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
					"given": { "type": "string", "minLength": 1 },
					"when": { "type": "string", "minLength": 1 },
					"then": { "type": "string", "minLength": 1 }
				}
			},
			"uniqueItems": true
		}
	}
}

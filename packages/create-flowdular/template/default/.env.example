# Production configuration for this Flowdular app. Copy it, fill in every value
# and keep the copy out of git. The .env this scaffold generated is the local
# development file and already carries working keys for embedded PostgreSQL.
#
# Generate each 32 byte key with: openssl rand -base64 32
# For FD_AUTH_MFA_KEY use the URL-safe alphabet: openssl rand -base64 32 | tr '+/' '-_'

NODE_ENV=production
FD_PORT=3000

# One PostgreSQL database, three roles. The migrator owns the schema, the
# runtime role holds neither SUPERUSER nor BYPASSRLS so the row-level security
# every tenant table forces actually binds the app, and the background role
# serves the cross-tenant scheduler poll. pglite is refused in production.
FD_DATABASE_ADAPTER=postgresql
FD_DATABASE_URL=postgresql://coreloom_runtime:REPLACE_ME@postgres:5432/flowdular
FD_DATABASE_MIGRATOR_URL=postgresql://coreloom_migrator:REPLACE_ME@postgres:5432/flowdular
FD_DATABASE_BACKGROUND_URL=postgresql://coreloom_background:REPLACE_ME@postgres:5432/flowdular
FD_DATABASE_TLS=verify-full
FD_DATABASE_TLS_CA_FILE=/tls/server.crt

# TLS terminates in front of the app. Set this to false only for a plain-HTTP
# run on a workstation: the session cookie then loses the Secure flag and the
# __Host- prefix.
FD_AUTH_SECURE_COOKIE=true
FD_AUTH_ALLOW_SIGN_UP=false

# Trust x-forwarded-for and x-forwarded-proto. Keep false unless a proxy you
# control terminates TLS in front of the app and overwrites those headers; on a
# directly reachable port a client can forge the address the sign-in limiter
# and the audit trail record. The compose sample publishes the port directly.
FD_TRUST_PROXY=false

# agents.core, automations.core and workflows.core each refuse to boot in
# production without their key.
FD_AGENT_CREDENTIAL_KEY=
FD_AGENT_RUN_GRANT_KEY=
FD_AUTOMATIONS_CREDENTIAL_KEY=
FD_NOTIFICATIONS_SECRET_KEY=
FD_WORKFLOWS_PAYLOAD_KEY=
FD_WORKFLOWS_CURSOR_KEY=

# Object storage. The local adapter is refused in production, so a deployment
# points at an S3-compatible bucket (AWS, MinIO, R2). Objects are encrypted with
# AES-256-GCM under this key before they are written, and the key is required in
# production: without it stored objects cannot be read back.
FD_STORAGE_ADAPTER=s3
FD_STORAGE_S3_BUCKET=
FD_STORAGE_S3_REGION=
FD_STORAGE_S3_ENDPOINT=
FD_STORAGE_S3_ACCESS_KEY_ID=
FD_STORAGE_S3_SECRET_ACCESS_KEY=
FD_STORAGE_S3_FORCE_PATH_STYLE=false
FD_STORAGE_MAX_OBJECT_BYTES=26214400
FD_STORAGE_ENCRYPTION_KEY=
FD_CONNECTORS_SECRET_KEY=
FD_AUDIT_ANCHOR_KEY=

# Retired keys, comma separated, at most eight each. Rotation replaces a key
# without losing what it sealed: move the old key here, put the new one above,
# deploy, re-seal the stored rows with the matching "<module> secrets-rotate
# --apply", then empty the entry. Full procedure in docs/operations.md.
FD_AGENT_CREDENTIAL_KEY_PREVIOUS=
FD_AUTOMATIONS_CREDENTIAL_KEY_PREVIOUS=
FD_NOTIFICATIONS_SECRET_KEY_PREVIOUS=
FD_WORKFLOWS_PAYLOAD_KEY_PREVIOUS=
FD_WORKFLOWS_CURSOR_KEY_PREVIOUS=
FD_STORAGE_ENCRYPTION_KEY_PREVIOUS=
FD_CONNECTORS_SECRET_KEY_PREVIOUS=
FD_AUDIT_ANCHOR_KEY_PREVIOUS=

# Base64url 32 byte key encrypting MFA secrets. Without it the app runs and only
# MFA enrollment is unavailable. It rotates the same way, through
# "flowdular auth secrets-rotate --apply".
FD_AUTH_MFA_KEY=
FD_AUTH_MFA_KEY_PREVIOUS=

# Outgoing mail. With none, workspace invitations are refused and password reset
# messages are never delivered. Set smtp and both values below to send them; the
# URL carries the relay password, so treat the filled copy as a secret.
FD_AUTH_MAIL_TRANSPORT=none
FD_AUTH_SMTP_URL=
FD_AUTH_MAIL_FROM=

# Read by infra/docker/compose.yaml only. It builds the three URLs above from
# these passwords and publishes the container port on FD_PORT.
FD_POSTGRES_SUPERUSER_PASSWORD=
FD_DATABASE_MIGRATOR_PASSWORD=
FD_DATABASE_RUNTIME_PASSWORD=
FD_DATABASE_BACKGROUND_PASSWORD=

# Prometheus exposition on GET /api/metrics. Leave FD_METRICS unset to keep it off.
FD_METRICS=false
FD_METRICS_TOKEN=

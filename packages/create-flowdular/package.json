{
	"name": "create-flowdular",
	"version": "0.2.6",
	"type": "module",
	"description": "Scaffold a Flowdular application: the platform, one example module and the secrets a fresh install needs.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/flowdular/flowdular.git",
		"directory": "packages/create-flowdular"
	},
	"homepage": "https://flowdular.com",
	"bugs": "https://github.com/flowdular/flowdular/issues",
	"keywords": [
		"flowdular",
		"octanejs",
		"scaffold",
		"create",
		"starter"
	],
	"bin": {
		"create-flowdular": "./dist/bin.js"
	},
	"files": [
		"dist",
		"template",
		"README.md",
		"assets",
		"agent-template"
	],
	"engines": {
		"node": ">=22.22.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "node ../../scripts/generator-agent-template.mjs && tsx src/bin.ts",
		"build": "node ../../scripts/generator-agent-template.mjs && esbuild src/bin.ts --bundle --platform=node --format=esm --outfile=dist/bin.js --banner:js=\"#!/usr/bin/env node\"",
		"prepublishOnly": "pnpm build",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "node ../../scripts/generator-agent-template.mjs && vitest run"
	},
	"devDependencies": {
		"@types/node": "24.13.3",
		"esbuild": "0.28.2",
		"tsx": "4.23.13",
		"typescript": "5.9.3",
		"vitest": "4.1.11",
		"@flowdular/dev-console": "workspace:*"
	}
}
